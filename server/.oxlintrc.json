{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc"],
  "categories": {
    "correctness": "error"
  },
  "rules": {},
  "env": {
    "builtin": true,
    "node": true
  },
  "ignorePatterns": ["dist/**", "node_modules/**", "drizzle/meta/**"],
  "overrides": [
    {
      "files": ["test/**", "**/*.test.ts"],
      "env": {
        "node": true
      },
      "rules": {
        "typescript/no-explicit-any": "off"
      }
    },
    {
      "files": ["scripts/**"],
      "rules": {
        "no-console": "off"
      }
    }
  ]
}
