# agentbridge gateway — copy to .env and adjust.
# Full reference: ../docs/SETUP.md

# --- Required ---
DATABASE_URL=postgres://agentbridge:agentbridge@localhost:5432/agentbridge
# Min 32 chars. Generate for production: openssl rand -base64 32
BETTER_AUTH_SECRET=dev-secret-change-in-production-min-32-chars
# Public browser origin (OAuth cookies, redirects). Must match how users reach the gateway.
BETTER_AUTH_URL=http://localhost:8787
# OAuth resource id for MCP; must match what MCP clients register against (usually {origin}/mcp)
MCP_RESOURCE=http://localhost:8787/mcp
PORT=8787

# --- Optional OAuth (omit a pair to hide that provider in the UI) ---
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# --- Email verification (Resend). Without RESEND_API_KEY, links print to the gateway console. ---
RESEND_API_KEY=
RESEND_FROM=agentbridge <onboarding@resend.dev>

# --- Optional tuning ---
# NODE_ENV=development
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
# MAX_THREADS_PER_DEVICE=8
# MAX_EVENTS_PER_THREAD=10000
# APPROVAL_TIMEOUT_MS=900000

# --- Optional UI path (Docker sets WEB_DIST=/app/public). Local dev uses ../web/dist automatically. ---
# WEB_DIST=
